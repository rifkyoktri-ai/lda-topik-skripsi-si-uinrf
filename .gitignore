# ── Environment ─────────────────────────────────────────────────────────────
.venv
.env
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# ── Runtime output ──────────────────────────────────────────────────────────
# Runtime output
logs/
*.log
# Catatan: folder 'experiments/' TIDAK diabaikan lagi. Dulu ada di sini
# karena src/evaluation_lda.py menulis ke Path("experiments") relatif di root.
# Sekarang Semua keluaran ke outputs/experiments/ lewat config.py dan ikut
# ter-commit, konsisten dengan folder hasil lainnya.

# ── Office lock files ───────────────────────────────────────────────────────
~$*.xlsx
~$*.docx

# ── Dokumen backup ──────────────────────────────────────────────────────────
*.backup.docx
*.backup2.docx
*.backup_tables.docx

# ── Binary besar (di-ignore secara umum) ─────────────────────────────────────
*.gensim
*.gensim.*
*.npy
*.pkl

# ...KECUALI artefak yang WAJIB ikut commit agar skripsi dapat direproduksi.
# CATATAN: pola '!' harus selalu ditulis SESUDAH pola generalnya di atas.
# Kalau folder hasil berpindah, negate di sini WAJIB ikut diperbarui juga,
# jika tidak file model diam-diam lepas dari git.
# Jaring pengamannya: tests/test_structure.py (test_artefak_model_tertrack).
!outputs/model/lda_model.gensim
!outputs/model/lda_model.gensim.expElogbeta.npy
!outputs/model/lda_model.gensim.id2word
!outputs/model/lda_model.gensim.state
!outputs/topics/corpus_corrected.pkl
!data/intermediate/dictionary.gensim
!data/intermediate/corpus.pkl

# ...selama transisi, path lama masih perlu pengecualian ───────────────────
!model/lda_model.gensim
!model/lda_model.gensim.expElogbeta.npy
!model/lda_model.gensim.id2word
!model/lda_model.gensim.state
!_fix_final/corpus_corrected.pkl

# ── Sampah scraper (aset CSS/JS/GIF hasil "Save Page As") ──────────────────
data/raw/**/*_files/
**/*.unduhan
**/css(1)
**/css(2)

# ── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
.ipynb_checkpoints